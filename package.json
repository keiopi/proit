{
  "name": "proit",
  "version": "0.1.0",
  "private": true,
  "description": "ProIT - Operations Service Dashboard for IT Services & Management",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server/index.js && esbuild src/server/db/cli.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server/cli.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "db:migrate": "node dist/server/cli.js migrate",
    "db:seed": "node dist/server/cli.js seed",
    "db:reset": "node dist/server/cli.js reset"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@tanstack/react-query": "^5.66.0",
    "express": "^5.1.0",
    "lucide-react": "^0.475.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
